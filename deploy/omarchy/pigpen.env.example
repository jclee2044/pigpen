# Install privately at /home/pigpen/.config/pigpen/pigpen.env, mode 0600.
PIGPEN_ENV=production
PIGPEN_DATA_DIR=/home/pigpen/.local/share/pigpen-production
PIGPEN_STATIC_DIR=/home/pigpen/.local/share/pigpen-static/current
PIGPEN_VAPID_PRIVATE_KEY=/home/pigpen/.config/pigpen/vapid.pem
PIGPEN_VAPID_SUBJECT=https://pigpen.example.com:8445

# Copy into private runtime configuration outside the checkout; use an absolute path.
PIGPEN_ENV=development
PIGPEN_DATA_DIR=/absolute/path/outside/checkout/pigpen-development
# Optional: only required for real push delivery; never commit a private key.
# PIGPEN_VAPID_PRIVATE_KEY=/absolute/private/path/vapid.pem
# PIGPEN_VAPID_SUBJECT=mailto:your-address@example.com
